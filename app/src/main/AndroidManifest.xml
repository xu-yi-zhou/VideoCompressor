<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 存储权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+ 部分媒体访问权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 防止息屏休眠 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 压缩成品上传到百度网盘 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 自更新：调系统安装器安装从 GitHub Releases 下载的 APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MIUI 省电策略页 intent 可见性声明 -->
    <queries>
        <intent>
            <action android:name="miui.intent.action.POWER_HIDE_MODE_APP_LIST" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.VideoCompressor">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 自更新：向系统安装器暴露下载到 cacheDir/update/ 的 APK -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 前台服务：防止后台被 MIUI/HyperOS 杀死 -->
        <service
            android:name=".service.CompressService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>
</manifest>
